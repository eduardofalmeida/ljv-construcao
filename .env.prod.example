# Copie para .env.prod na VPS e ajuste os valores:
#   cp .env.prod.example .env.prod

# --- Postgres (obrigatório: mude a senha) ---
POSTGRES_DB=ljv_construcao
POSTGRES_USER=ljv_user
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE

# --- URL pública (acesso pelo IP por enquanto) ---
APP_CORS_ALLOWED_ORIGINS=http://177.153.22.65

# HTTP sem domínio: cookie SameSite=lax e Secure=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false

# true cria admin/admin123 na primeira subida (troque a senha depois)
APP_DEV_SEED_DATA=true
JPA_DDL_AUTO=update

# Porta HTTP publicada na VPS
HTTP_PORT=80
