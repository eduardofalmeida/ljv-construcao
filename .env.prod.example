# Copie para .env.prod na VPS:
#   cp .env.prod.example .env.prod

# --- Postgres (obrigatório: mude a senha) ---
POSTGRES_DB=ljv_construcao
POSTGRES_USER=ljv_user
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE

# --- URL pública ---
APP_CORS_ALLOWED_ORIGINS=http://www.ljvconstrucao.com.br,http://ljvconstrucao.com.br,http://177.153.22.65

SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false

APP_DEV_SEED_DATA=true
JPA_DDL_AUTO=update
HIKARI_MAX_POOL_SIZE=3
TOMCAT_MAX_THREADS=40
HTTP_PORT=80

# Imagens (padrão = enviadas pelo Mac via deploy/ship-from-mac.sh)
BACKEND_IMAGE=ljv-backend:latest
FRONTEND_IMAGE=ljv-frontend:latest

# Depois que o GitHub Actions publicar no GHCR, pode usar:
# BACKEND_IMAGE=ghcr.io/eduardofalmeida/ljv-construcao-backend:latest
# FRONTEND_IMAGE=ghcr.io/eduardofalmeida/ljv-construcao-frontend:latest
# GHCR_USER=eduardofalmeida
# GHCR_TOKEN=ghp_xxx   # PAT com read:packages (se o pacote for privado)
