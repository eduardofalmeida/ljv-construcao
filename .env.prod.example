# Copie para .env.prod na VPS:
#   cp .env.prod.example .env.prod

# --- Postgres (obrigatório: mude a senha) ---
POSTGRES_DB=ljv_construcao
POSTGRES_USER=ljv_user
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE

# --- URL pública ---
APP_CORS_ALLOWED_ORIGINS=http://www.ljvconstrucao.com.br,http://ljvconstrucao.com.br,http://177.153.22.65

# HTTP por enquanto (HTTPS depois)
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false

# true cria admin/admin123 na primeira subida
APP_DEV_SEED_DATA=true
JPA_DDL_AUTO=update

# Ajuste fino VPS 4GB (já tem defaults bons no compose)
HIKARI_MAX_POOL_SIZE=3
TOMCAT_MAX_THREADS=40

HTTP_PORT=80
