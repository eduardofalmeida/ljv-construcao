# =====================================================
# Variáveis do serviço FRONTEND no Railway
# =====================================================
# No Vite, VITE_* precisa existir no BUILD (não só em runtime).
# Settings → Build → Variables, ou Variables do serviço.

# URL pública do backend. O navegador NÃO chama esse endereço.
# O servidor do frontend lê esta variável e encaminha /api para cá,
# para o cookie de sessão ficar no mesmo site. Sem isso, os menus voltam 401.
VITE_API_URL=https://SEU-BACKEND.up.railway.app/api
