# =====================================================
# Variáveis do serviço BACKEND no Railway
# =====================================================
# Em Variables → Add Variable Reference (ligar ao Postgres)
# ou cole os valores abaixo usando ${{Postgres.NOME}}.

# Porta (Railway já injeta PORT — não precisa criar manualmente)
# PORT=8080

# --- PostgreSQL ---
# Cole no serviço BACKEND (não no Postgres): Variables → Raw Editor.
# "Postgres" é o nome do serviço do banco. Se o seu tiver outro nome, troque.
# A rede privada do Railway não usa SSL. Não copie senha na mão.
#
# DATABASE_URL vem como postgres:// e o Spring não aceita. Use a URL JDBC abaixo.
# Não referencie PGDATA, SSL_CERT_DAYS nem RAILWAY_DEPLOYMENT_DRAINING_SECONDS.

SPRING_DATASOURCE_URL=jdbc:postgresql://${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
SPRING_DATASOURCE_USERNAME=${{Postgres.PGUSER}}
SPRING_DATASOURCE_PASSWORD=${{Postgres.PGPASSWORD}}

PGHOST=${{Postgres.PGHOST}}
PGPORT=${{Postgres.PGPORT}}
PGDATABASE=${{Postgres.PGDATABASE}}
PGUSER=${{Postgres.PGUSER}}
PGPASSWORD=${{Postgres.PGPASSWORD}}

# --- Frontend (URL pública do serviço frontend) ---
APP_CORS_ALLOWED_ORIGINS=https://SEU-FRONTEND.up.railway.app

# Cookie de sessão entre domínios diferentes (frontend ≠ backend)
SESSION_COOKIE_SAME_SITE=none
SESSION_COOKIE_SECURE=true

# Produção
APP_DEV_SEED_DATA=false
JPA_DDL_AUTO=update
