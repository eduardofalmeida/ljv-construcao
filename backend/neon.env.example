# =====================================================
# Neon — cole no serviço do BACKEND (Render ou local)
# =====================================================
# Arquivo de exemplo. Não coloque a senha real aqui.
# No seu computador, copie para backend/.env (esse arquivo o Git ignora).
# O backend lê DATABASE_URL desse arquivo ou da variável de ambiente.

# Connection string direta ou com -pooler, como o painel do Neon mostra.
# sslmode=require é obrigatório. channel_binding pode ficar: o backend remove.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Primeira subida cria as tabelas e o usuário inicial. Depois desligue o seed.
APP_DEV_SEED_DATA=true
JPA_DDL_AUTO=update
